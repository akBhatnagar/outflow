{
  "name": "@outflow/web",
  "version": "0.0.1",
  "private": true,
  "description": "Outflow Web — Next.js 15 frontend",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "start": "next start --port ${WEB_PORT:-3000}",
    "lint": "next lint",
