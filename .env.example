######################################
# Outflow - Example environment vars
# Copy to .env (root) for docker compose
######################################

# ---- Postgres (used by docker compose + api) ----
POSTGRES_USER=outflow
POSTGRES_PASSWORD=outflow_dev_pw
POSTGRES_DB=outflow
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- API (NestJS) ----
API_PORT=4000
API_NODE_ENV=development
# Connection string the API uses inside docker (host = postgres service name)
DATABASE_URL=postgresql://outflow:outflow_dev_pw@postgres:5432/outflow?schema=public
REDIS_URL=redis://redis:6379

# JWT signing keys (placeholders; rotate for prod, use RS256 keypair files)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Encryption key for OAuth tokens at rest (32-byte base64)
TOKEN_ENCRYPTION_KEY=base64:replace-with-32-byte-key

# Google OAuth (for app login + Gmail data scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
GMAIL_OAUTH_REDIRECT_URI=http://localhost:4000/integrations/gmail/callback

# OpenAI (LLM fallback parser)
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FAMILY=

# ---- Mail ----
# Driver: smtp (use Mailhog/any SMTP), resend (HTTP API), log (no-op for tests)
MAIL_DRIVER=smtp
MAIL_FROM=Outflow <noreply@localhost>
# SMTP transport (Mailhog by default; UI at http://localhost:8025)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend (used only when MAIL_DRIVER=resend)
RESEND_API_KEY=

# ---- Have I Been Pwned password lookup ----
# Set to "false" to skip the network call (e.g. when offline).
HIBP_ENABLED=true

# Sentry (optional in dev)
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# ---- Web (Next.js) ----
WEB_PORT=3000
# Browser → API: in local dev, leave NEXT_PUBLIC_API_URL unset and Next.js
# rewrites `/api/*` to the Nest server (see apps/web/next.config.mjs). For a
# split origin (e.g. web on :3000, API on :4000 without rewrites), set both URLs.
# In production Docker behind nginx, omit NEXT_PUBLIC_API_URL so the client
# bundle uses same-origin `/api/v1/...` (avoids baking localhost into the build).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used only by server-side fetches from the web container (RSC). Compose sets
# this to http://api:4000 automatically in docker-compose.*.yml.
API_INTERNAL_URL=http://localhost:4000
